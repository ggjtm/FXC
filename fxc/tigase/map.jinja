{#- Native Tigase 8.4.1: same vendor dist tarball as docker/tigase/Dockerfile, on a native JDK 17
    (fxc.common.jdk17 — never jdk21, see docker/tigase/Dockerfile's comment). Ports/build ref match
    the Dockerfile; MariaDB connection + service-account password come from pillar. #}
{% import 'fxc/map.jinja' as fxc_root with context %}
{% set tigase = salt['grains.filter_by']({
    'default': {
        'build': '8.4.1-b12419',
        'download_url': 'https://github.com/tigase/tigase-server/releases/download/tigase-server-8.4.1/tigase-server-8.4.1-b12419-dist.tar.gz',
        'install_dir': fxc_root.fxc.base_dir ~ '/tigase',
        'service_name': 'fxctigase',
        'c2s_port': 5222,
        's2s_port': 5269,
        'http_port': 5280,
        'admin_port': 8080,
        'virtual_host': 'fxc.local',
        'admin_jid': 'admin@fxc.local',
        'service_accounts': 'admin@fxc.local,broker@fxc.local,pub-service@fxc.local,investor@fxc.local',
    },
}, merge=salt['pillar.get']('fxc:tigase', {})) %}

{#- JDK 17 home varies by distro packaging; only this one key needs an os_family split. #}
{% set jdk17_home = salt['grains.filter_by']({
    'Debian': '/usr/lib/jvm/java-17-openjdk-amd64',
    'RedHat': '/usr/lib/jvm/java-17-openjdk',
}, grain='os_family', default='Debian') %}
