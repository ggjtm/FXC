{#- Formula-wide defaults: service user/group, base install dir, per-os JDK package names, and
    the MariaDB connection defaults every component's conf template reads. Each os_family block is
    self-contained (the saltstack-formulas.org convention) so grains.filter_by's `merge=` only has
    to layer pillar overrides on top, not reconcile a shared 'default' block. #}
{% set fxc = salt['grains.filter_by']({
    'default': {
        'service_user': 'fxc',
        'service_group': 'fxc',
        'base_dir': '/opt/fxc',
        'jdk17_pkg': 'openjdk-17-jdk',
        'jdk21_pkg': 'openjdk-21-jdk',
        'mariadb_host': 'localhost',
        'mariadb_port': 3306,
        'mariadb_app_user': 'fxc',
    },
    'Debian': {
        'service_user': 'fxc',
        'service_group': 'fxc',
        'base_dir': '/opt/fxc',
        'jdk17_pkg': 'openjdk-17-jdk',
        'jdk21_pkg': 'openjdk-21-jdk',
        'mariadb_host': 'localhost',
        'mariadb_port': 3306,
        'mariadb_app_user': 'fxc',
    },
    'RedHat': {
        'service_user': 'fxc',
        'service_group': 'fxc',
        'base_dir': '/opt/fxc',
        'jdk17_pkg': 'java-17-openjdk-devel',
        'jdk21_pkg': 'java-21-openjdk-devel',
        'mariadb_host': 'localhost',
        'mariadb_port': 3306,
        'mariadb_app_user': 'fxc',
    },
}, grain='os_family', merge=salt['pillar.get']('fxc:common', {})) %}

{#- Debian 13 (trixie) dropped openjdk-17 from the archive (only 21/25 ship), so JDK 17 comes from
    Adoptium's Temurin repo there instead — fxc/docs/PROBLEMS.md P9. A pillar-supplied
    fxc:common:jdk17_pkg still wins; jdk17_from_adoptium tells jdk17.sls to manage the repo and
    tigase/map.jinja which JAVA_HOME to point at. #}
{% if fxc.get('jdk17_pkg') == 'openjdk-17-jdk'
      and grains['os_family'] == 'Debian'
      and grains.get('osmajorrelease', 0) | int >= 13 %}
{% do fxc.update({'jdk17_pkg': 'temurin-17-jdk', 'jdk17_from_adoptium': True}) %}
{% endif %}

{#- GridGain 8 on JDK 9+ requires this exact --add-opens set (root build.gradle.kts's
    `igniteJvmArgs`, source: .reference/gridgain/README.md §2) for every embedded-GridGain
    component (exchange/broker/pub) launched outside Gradle. Kept as one formula-wide string so a
    change to the Gradle side and the Salt side can be reconciled by diffing this against
    build.gradle.kts rather than hunting three separate copies. #}
{% set gridgain_jvm_opts = [
    "--add-opens=java.base/jdk.internal.access=ALL-UNNAMED",
    "--add-opens=java.base/jdk.internal.misc=ALL-UNNAMED",
    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED",
    "--add-opens=java.base/sun.util.calendar=ALL-UNNAMED",
    "--add-opens=java.management/com.sun.jmx.mbeanserver=ALL-UNNAMED",
    "--add-opens=jdk.internal.jvmstat/sun.jvmstat.monitor=ALL-UNNAMED",
    "--add-opens=java.base/sun.reflect.generics.reflectiveObjects=ALL-UNNAMED",
    "--add-opens=jdk.management/com.sun.management.internal=ALL-UNNAMED",
    "--add-opens=java.base/java.io=ALL-UNNAMED",
    "--add-opens=java.base/java.nio=ALL-UNNAMED",
    "--add-opens=java.base/java.net=ALL-UNNAMED",
    "--add-opens=java.base/java.util=ALL-UNNAMED",
    "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED",
    "--add-opens=java.base/java.util.concurrent.locks=ALL-UNNAMED",
    "--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED",
    "--add-opens=java.base/java.lang=ALL-UNNAMED",
    "--add-opens=java.base/java.lang.invoke=ALL-UNNAMED",
    "--add-opens=java.base/java.math=ALL-UNNAMED",
    "--add-opens=java.sql/java.sql=ALL-UNNAMED",
] | join(' ') %}

{#- QuickFIX/J logs EVERY FIX message in and out through slf4j at INFO, and slf4j-simple (the only
    binding on the classpath — there is no logback.xml or simplelogger.properties anywhere) defaults
    every logger to INFO on a synchronized System.err. At the demo's 8-user scale that was invisible;
    at 512 investors it is roughly 6-8 lines per order across three JVMs, all serialized on one
    stream lock, and gigabytes an hour into journald — the harness's own first bottleneck.

    So the FIX interface logs at WARN unless someone is actively debugging it. The category names are
    QuickFIX/J's own (verified against SLF4JLog in quickfixj-core 3.0.1). `quickfixj.errorEvent` is
    deliberately NOT gated: errors must never be suppressed by a throughput setting.

    To debug the FIX wire, set fxc:common:fix_log_level to 'info' (message-level) or 'debug' in
    pillar and re-apply — no template edit, no rebuild. #}
{% set fix_log_level = salt['pillar.get']('fxc:common:fix_log_level', 'warn') %}
{% set fix_log_opts = [
    '-Dorg.slf4j.simpleLogger.log.quickfixj.msg.incoming=' ~ fix_log_level,
    '-Dorg.slf4j.simpleLogger.log.quickfixj.msg.outgoing=' ~ fix_log_level,
    '-Dorg.slf4j.simpleLogger.log.quickfixj.event=' ~ fix_log_level,
] | join(' ') %}

{#- JDK 21 home varies by distro packaging (used by exchange/broker/pub/investor systemd units).
    Debian suffixes the CPU arch, so derive it from grains — a hardcoded -amd64 crash-looped every
    JDK21 service on arm64 (P18; jdk17_home in tigase/map.jinja got the same fix under P9). #}
{% set jdk21_home = salt['grains.filter_by']({
    'Debian': '/usr/lib/jvm/java-21-openjdk-' ~ grains['osarch'],
    'RedHat': '/usr/lib/jvm/java-21-openjdk',
}, grain='os_family', default='Debian') %}
